# WoS file fields that are taken into consideration:
# AU = "" ## Authors
# TI = "" ## Document Title
# LA = "" ## Language
# DT = "" ## Document Type
# DE = "" ## Author Keywords
# ID = "" ## Keywords Plus
# AB = "" ## Abstract
# C1 = "" ## Author Address
# CR = "" ## Cited References
# TC = "" ## Times Cited
# PY = 0 ## Year Published
# DI = "" ## Digital Object Identifier (DOI)
# SC = "" ## Subject Category

# Requirements:
# - pip
# - python3
# - pandas
# - os

# Data Preparation:

# The following options are available for data preparation:
# 1 - Convert wos file to excel file 
# To use this option you must run command:
# python run.py process_a somefile.txt
#

##
## To run try this: python3 -m http.server 8000


